{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "清风AI系统",
  "mainBinaryName": "qingfeng-system",
  "version": "0.11.1",
  "identifier": "com.qingjiu.qingfeng",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "清风AI系统",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["pdfium.dll"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
